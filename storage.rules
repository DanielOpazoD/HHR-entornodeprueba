rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function normalizeRole(role) {
      return role == 'viewer_census' ? 'viewer' : role;
    }

    function normalizedRole() {
      let email = isAuthenticated() ? request.auth.token.get('email', null) : null;
      let rolesPath = /databases/(default)/documents/config/roles;
      let configuredRole = email is string && firestore.exists(rolesPath)
        ? firestore.get(rolesPath).data.get(email.lower(), null)
        : null;
      let claimRole = isAuthenticated() ? request.auth.token.get('role', null) : null;
      // Explicit revocations and downgrades take precedence over an already issued token.
      return normalizeRole(configuredRole != null ? configuredRole : claimRole);
    }

    function hasNormalizedRole(roles) {
      return isAuthenticated() && normalizedRole() in roles;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasClinicalReadRole() {
      // Storage covers exports, templates, backups and reminder assets.
      // `doctor_specialist` keeps access to clinical data via Firestore rules,
      // but is intentionally excluded from these storage surfaces.
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'doctor_urgency',
        'viewer',
        'editor'
      ]);
    }

    function hasClinicalWriteRole() {
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'editor'
      ]);
    }

    function canWriteReminderAssets() {
      return hasClinicalWriteRole();
    }

    function canReadClinicalStorage() {
      return hasClinicalReadRole();
    }

    function canReadClinicalAttachments() {
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'doctor_urgency',
        'doctor_specialist',
        'viewer',
        'editor'
      ]);
    }

    function canWriteClinicalAttachments() {
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'doctor_urgency',
        'doctor_specialist',
        'editor'
      ]);
    }

    // Entrega de enfermería backups: editable only by clinical editors.
    match /entregas-enfermeria/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole();
    }
    
    // Daily census exports: readable by authenticated clinical users.
    match /censo-diario/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole();
    }
    
    // Templates can be read by authorized clinical/shared users.
    match /templates/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if false;  // Only upload via Firebase Console
    }
    
    // CUDYR monthly backups: editable only by clinical editors.
    match /cudyr-backup/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole();
    }

    match /reminders/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if canWriteReminderAssets();
    }

    match /user-avatars/{userId}/{fileName} {
      allow read: if isCurrentUser(userId);
      allow write: if isCurrentUser(userId)
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /clinical-attachments/{hospitalId}/{patientRutKey}/{episodeKey}/{attachmentId}/{fileName} {
      allow read: if canReadClinicalAttachments();
      allow write: if canWriteClinicalAttachments()
                      && request.resource.size < 15 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*|application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Prescription-photo backup blobs are written and cleaned up only by
    // server-side Cloud Functions. Clinical clients only resolve thumbnails/full images.
    match /prescriptions/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if false;
    }

    // Wound care: clinical photography and informed consent documents.
    match /wound-care/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole()
                      && request.resource.size < 15 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
