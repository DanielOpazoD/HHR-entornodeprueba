rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function individualAccessPolicy() {
      let p = /databases/(default)/documents/config/individualAccounts;
      return firestore.exists(p) ? firestore.get(p).data : {};
    }

    // The server reserves hhrn_ UIDs for managed accounts. Route by signed identity
    // before reading documents: legacy uses policy + roles, managed uses access only.
    function isManagedIdentity() {
      return request.auth != null && (request.auth.uid.matches('hhrn_.*') ||
        request.auth.token.keys().hasAny(['hhrAccountVersion']));
    }

    function managedAccount() {
      return firestore.get(/databases/(default)/documents/hhr_account_access/$(request.auth.uid)).data;
    }

    function hasCurrentManagedSession() {
      let account = managedAccount();
      let authTime = request.auth.token.get('auth_time', 0);
      return account.status == 'active' && account.get('credentialOperation', null) == null &&
        request.auth.token.get('hhrAccountVersion', -1) == account.version &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password' &&
        authTime > 0 && authTime <= request.time.toMillis() / 1000 + 60 &&
        request.time.toMillis() / 1000 < authTime + 43200;
    }

    function protectedGoogleRole() {
      let email = request.auth.token.get('email', '').lower();
      let known = individualAccessPolicy().get('protectedGoogle', {});
      let verified = request.auth.token.get('email_verified', false) &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com' &&
        known.get(email, '') == request.auth.uid;
      return verified ? individualAccessPolicy().get('protectedRoles', {}).get(request.auth.uid, null) : null;
    }

    function isIndividualAccessEnabled() {
      return individualAccessPolicy().get('enabled', false) == true;
    }

    function isAuthenticated() {
      return request.auth != null && (isManagedIdentity() ? hasCurrentManagedSession() :
        (request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password' &&
          (!isIndividualAccessEnabled() || protectedGoogleRole() != null)));
    }

    function normalizeRole(role) {
      return role == 'viewer_census' ? 'viewer' : role;
    }

    function legacyNormalizedRole() {
      let email = request.auth.token.get('email', null);
      let rolesPath = /databases/(default)/documents/config/roles;
      let configuredRole = email is string && firestore.exists(rolesPath)
        ? firestore.get(rolesPath).data.get(email.lower(), null)
        : null;
      let claimRole = request.auth.token.get('role', null);
      // Explicit revocations and downgrades take precedence over an already issued token.
      return normalizeRole(configuredRole != null ? configuredRole : claimRole);
    }

    function normalizedRole() {
      return !isAuthenticated() ? null : isManagedIdentity() ? managedAccount().role :
        isIndividualAccessEnabled() ? protectedGoogleRole() : legacyNormalizedRole();
    }

    function hasNormalizedRole(roles) {
      return isAuthenticated() && normalizedRole() in roles;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasClinicalReadRole() {
      // Storage covers exports, templates, backups and reminder assets.
      // `doctor_specialist` keeps access to clinical data via Firestore rules,
      // but is intentionally excluded from these storage surfaces.
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'doctor_urgency',
        'viewer',
        'editor'
      ]);
    }

    function hasClinicalWriteRole() {
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'editor'
      ]);
    }

    function canWriteReminderAssets() {
      return hasClinicalWriteRole();
    }

    function canReadClinicalStorage() {
      return hasClinicalReadRole();
    }

    function canReadClinicalAttachments() {
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'doctor_urgency',
        'doctor_specialist',
        'viewer',
        'editor'
      ]);
    }

    function canWriteClinicalAttachments() {
      return hasNormalizedRole([
        'admin',
        'nurse_hospital',
        'doctor_urgency',
        'doctor_specialist',
        'editor'
      ]);
    }

    // Entrega de enfermería backups: editable only by clinical editors.
    match /entregas-enfermeria/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole();
    }
    
    // Daily census exports: readable by authenticated clinical users.
    match /censo-diario/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole();
    }
    
    // Templates can be read by authorized clinical/shared users.
    match /templates/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if false;  // Only upload via Firebase Console
    }
    
    // CUDYR monthly backups: editable only by clinical editors.
    match /cudyr-backup/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if hasClinicalWriteRole();
    }

    match /reminders/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if canWriteReminderAssets();
    }

    match /user-avatars/{userId}/{fileName} {
      allow read: if isCurrentUser(userId);
      allow create, update: if isCurrentUser(userId)
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isCurrentUser(userId);
    }

    match /clinical-attachments/{hospitalId}/{patientRutKey}/{episodeKey}/{attachmentId}/{fileName} {
      allow read: if canReadClinicalAttachments();
      allow create, update: if canWriteClinicalAttachments()
                      && request.resource.size < 15 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*|application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow delete: if canWriteClinicalAttachments();
    }

    // Prescription-photo backup blobs are written and cleaned up only by
    // server-side Cloud Functions. Clinical clients only resolve thumbnails/full images.
    match /prescriptions/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow write: if false;
    }

    // Wound care: clinical photography and informed consent documents.
    match /wound-care/{allPaths=**} {
      allow read: if canReadClinicalStorage();
      allow create, update: if hasClinicalWriteRole()
                      && request.resource.size < 15 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if hasClinicalWriteRole();
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
