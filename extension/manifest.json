{
  "manifest_version": 3,
  "minimum_chrome_version": "118",
  "name": "Rayen → HHR · Puente de censo",
  "version": "0.48.15",
  "description": "Conecta Eloísa con HHR e incorpora un centro de operaciones clínicas extensible.",
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "offscreen",
    "clipboardWrite",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://fichamedico.rayensalud.cl/*",
    "https://fichamedicoback.rayensalud.cl/*",
    "https://formulariosclinicosback.rayensalud.cl/*",
    "https://hospitalizado.rayensalud.cl/*",
    "https://hospbackend.rayensalud.cl/*",
    "http://10.4.69.90/syslab/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://testinghhr.netlify.app/*",
    "https://hhr-entornodeprueba.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ver versión del puente Eloísa → HHR",
    "default_popup": "extension-status.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "hhr-logo.svg",
        "message-contract.js",
        "fichamedico-manual-patient-copy.js",
        "syslab-login.html",
        "syslab-login.js",
        "forms/consentimiento.pdf",
        "forms/consentimiento.png",
        "forms/encuesta-contraste.pdf",
        "forms/encuesta_imagenologia.png",
        "forms/solicitud-imagen.pdf",
        "forms/solicitud_imagenologia.png"
      ],
      "matches": [
        "https://fichamedico.rayensalud.cl/*",
        "https://hospitalizado.rayensalud.cl/*"
      ]
    },
    {
      "resources": [
        "pdf.min.mjs",
        "pdf.worker.min.mjs"
      ],
      "matches": [
        "http://10.4.69.90/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fichamedico.rayensalud.cl/*"
      ],
      "js": [
        "fichamedico-isolation-normalization.js",
        "fichamedico-treating-physician-dom.js",
        "fichamedico-treating-physician-sources.js",
        "fichamedico-treating-physician-normalization.js",
        "fichamedico-normalization.js",
        "fichamedico-read-resilience.js",
        "bridge-generation-main.js",
        "inject-fichamedico.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fichamedico.rayensalud.cl/*"
      ],
      "js": [
        "message-contract.js",
        "bridge-generation.js",
        "hhr-ui.js",
        "hhr-center-styles.js",
        "hhr-center-shell-runtime.js",
        "hhr-prescription-center.js",
        "hhr-hospitalized-documents-center.js",
        "hhr-clinical-write-client-runtime.js",
        "hhr-handoff-center.js",
        "hhr-scores-presentation.js",
        "hhr-scores-center.js",
        "hhr-lab-center.js",
        "hhr-vitals.js",
        "hhr-vitals-center.js",
        "hhr-request-forms.js",
        "hhr-imaging-center.js",
        "hhr-discharge-actions-runtime.js",
        "hhr-medication-actions-runtime.js",
        "hhr-connection-action-model.js",
        "hhr-connection-repair-controls.js",
        "hhr-connection-center-runtime.js",
        "prescription-print.js",
        "lab-result-parser.js",
        "lab-viewer.js",
        "exam-request-print.js",
        "content-fichamedico.js",
        "fichamedico-manual-patient-copy.js",
        "content-exam-request-print.js",
        "content-prescription-print.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://hospitalizado.rayensalud.cl/*"
      ],
      "js": [
        "bridge-generation-main.js",
        "inject-gestioncamas.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://hospitalizado.rayensalud.cl/*"
      ],
      "js": [
        "message-contract.js",
        "bridge-generation.js",
        "gestion-camas-bridge-health.js",
        "hhr-connection-action-model.js",
        "gestion-camas-connection-indicator.js",
        "gestion-camas-connection-indicator-bootstrap.js",
        "content-gestioncamas.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://10.4.69.90/syslab/*"
      ],
      "js": [
        "lab-result-parser.js",
        "lab-viewer.js",
        "syslab-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "https://testinghhr.netlify.app/*",
        "https://hhr-entornodeprueba.vercel.app/*"
      ],
      "js": [
        "message-contract.js",
        "bridge-generation.js",
        "content-hhr-sync-bundle.js",
        "content-hhr-connection-repair.js",
        "content-hhr.js",
        "content-hhr-patient-flow.js",
        "content-hhr-epicrisis.js",
        "content-hhr-patient-documents.js",
        "content-hhr-statistical-discharge.js",
        "content-hhr-statistical-evidence.js",
        "content-hhr-syslab.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
