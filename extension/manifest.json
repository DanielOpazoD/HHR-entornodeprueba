{
  "manifest_version": 3,
  "name": "Rayen → HHR · Puente de censo",
  "version": "0.31.0",
  "description": "Conecta Eloísa con HHR e incorpora un centro de operaciones clínicas extensible.",
  "permissions": ["tabs", "downloads", "storage", "offscreen"],
  "host_permissions": [
    "https://fichamedico.rayensalud.cl/*",
    "https://fichamedicoback.rayensalud.cl/*",
    "https://formulariosclinicosback.rayensalud.cl/*",
    "https://hospitalizado.rayensalud.cl/*",
    "https://hospbackend.rayensalud.cl/*",
    "http://10.4.69.90/syslab/*",
    "http://localhost/*",
    "https://testinghhr.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "hhr-logo.svg",
        "message-contract.js",
        "syslab-login.html",
        "syslab-login.js",
        "forms/consentimiento.pdf",
        "forms/consentimiento.png",
        "forms/encuesta-contraste.pdf",
        "forms/encuesta_imagenologia.png",
        "forms/solicitud-imagen.pdf",
        "forms/solicitud_imagenologia.png"
      ],
      "matches": ["https://fichamedico.rayensalud.cl/*"]
    },
    {
      "resources": ["pdf.min.mjs", "pdf.worker.min.mjs"],
      "matches": ["http://10.4.69.90/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://fichamedico.rayensalud.cl/*"],
      "js": ["fichamedico-normalization.js", "inject-fichamedico.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://fichamedico.rayensalud.cl/*"],
      "js": [
        "message-contract.js",
        "hhr-ui.js",
        "hhr-center-styles.js",
        "hhr-center-shell-runtime.js",
        "hhr-prescription-center.js",
        "hhr-hospitalized-documents-center.js",
        "hhr-handoff-scores-center.js",
        "hhr-lab-center.js",
        "hhr-vitals.js",
        "hhr-request-forms.js",
        "hhr-imaging-center.js",
        "prescription-print.js",
        "lab-viewer.js",
        "exam-request-print.js",
        "content-fichamedico.js",
        "content-exam-request-print.js",
        "content-prescription-print.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://hospitalizado.rayensalud.cl/*"],
      "js": ["inject-gestioncamas.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://hospitalizado.rayensalud.cl/*"],
      "js": ["message-contract.js", "content-gestioncamas.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://10.4.69.90/syslab/*"],
      "js": ["lab-viewer.js", "syslab-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://localhost/*", "https://testinghhr.netlify.app/*"],
      "js": ["message-contract.js", "content-hhr.js"],
      "run_at": "document_idle"
    }
  ]
}
