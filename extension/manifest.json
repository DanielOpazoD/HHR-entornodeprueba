{
  "manifest_version": 3,
  "name": "Rayen → HHR · Puente de censo",
  "version": "0.24.1",
  "description": "Conecta Eloísa con HHR e incorpora un centro de operaciones clínicas extensible.",
  "permissions": ["tabs", "downloads", "storage"],
  "host_permissions": [
    "https://fichamedico.rayensalud.cl/*",
    "https://fichamedicoback.rayensalud.cl/*",
    "https://formulariosclinicosback.rayensalud.cl/*",
    "https://hospitalizado.rayensalud.cl/*",
    "https://hospbackend.rayensalud.cl/*",
    "http://localhost/*",
    "https://testinghhr.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["hhr-logo.svg"],
      "matches": ["https://fichamedico.rayensalud.cl/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://fichamedico.rayensalud.cl/*"],
      "js": ["fichamedico-normalization.js", "inject-fichamedico.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://fichamedico.rayensalud.cl/*"],
      "js": [
        "prescription-print.js",
        "lab-viewer.js",
        "exam-request-print.js",
        "content-fichamedico.js",
        "content-exam-request-print.js",
        "content-prescription-print.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://hospitalizado.rayensalud.cl/*"],
      "js": ["inject-gestioncamas.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://hospitalizado.rayensalud.cl/*"],
      "js": ["content-gestioncamas.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*", "https://testinghhr.netlify.app/*"],
      "js": ["content-hhr.js"],
      "run_at": "document_idle"
    }
  ]
}
