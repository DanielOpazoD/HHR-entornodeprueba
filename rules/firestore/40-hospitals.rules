    match /hospitals/{hospitalId} {
      allow read: if canReadClinicalData();
      allow write: if isAdmin();
      
      match /dailyRecords/{date} {
        allow read: if canReadClinicalData();
        allow create: if canEdit() && !isRayenClinicalWriteFenceActive(hospitalId);
        allow update: if canUpdatePersistedDailyRecord() && preservesServerOwnedClinicalState(hospitalId);
        // Delete: Admin only (nurses must not hard-delete census records)
        allow delete: if isAdmin();
        
        match /history/{historyId} {
          allow read: if canReadClinicalData();
          allow create: if canCreateEditableHospitalDocument();
          allow update, delete: if canAdminMaintainHospitalDocument();
        }

        // Recoverable conflict version snapshots. Auto-expire ~48h via a Firestore TTL policy on
        // the `expireAt` field. Preview/restore is restricted to admin + Hospitalizados HHR
        // (nurse_hospital); any user with editable hospital-document access
        // (canCreateEditableHospitalDocument) may still create a snapshot during normal conflict
        // resolution. See docs/ADR_CONFLICT_VERSION_RECOVERY.md.
        match /conflictSnapshots/{snapshotId} {
          allow read: if canManageClinicalConflictSnapshots();
          allow create: if canCreateEditableHospitalDocument();
          allow update, delete: if canAdminMaintainHospitalDocument();
        }
      }

      // Deleted Records (Trash)
      match /deletedRecords/{trashId} {
        allow read, write: if isAdmin();
      }
      
      match /clinicalDocuments/{documentId} {
        allow read: if canReadClinicalData();
        allow create, update: if canWriteClinicalDocument();
        allow delete: if canDeleteClinicalDocument();
      }

      match /clinicalAttachments/{attachmentId} {
        allow read: if canReadClinicalData();
        allow create, update: if canWriteClinicalAttachment();
        allow delete: if isAdmin();
      }

      match /clinicalDocumentTemplates/{templateId} {
        allow read: if canReadClinicalData();
        allow write: if isAdmin();
      }

      match /medicalIndicationTemplates/{userId} {
        allow read, write: if isCurrentUser(userId);

        match /items/{templateId} {
          allow read: if isCurrentUser(userId);
          allow create, update, delete: if isCurrentUser(userId) &&
            request.resource.data.userId == userId;
        }
      }

      match /medicalIndicationRecords/{recordId} {
        allow read: if canReadClinicalData();
        allow create: if isValidMedicalIndicationRecordCreate();
        allow update, delete: if false;
      }

      // Server-owned statistical reporting layer. Clients can inspect the
      // official reclassification applied to analytics, but writes must go
      // through setMinsalSpecialtyReclassification so admin role, IP and audit
      // metadata are captured consistently.
      match /analyticsSpecialtyReclassifications/{reclassificationId} {
        allow read: if canReadClinicalData();
        allow create, update, delete: if false;
      }

      match /settings/{settingId} {
        allow read: if canReadClinicalData();
        allow create: if settingId == 'rayenImportPolicy'
          ? canCreateRayenImportPolicy()
          : (settingId == 'aiProviderRouting' ? isAdmin() : canEdit());
        allow update: if settingId == 'rayenImportPolicy'
          ? canUpdateRayenImportPolicy()
          : (settingId == 'aiProviderRouting' ? isAdmin() : canEdit());
        allow delete: if settingId == 'rayenImportPolicy'
          ? false
          : (settingId == 'aiProviderRouting' ? isAdmin() : canEdit());
      }

      match /reminders/{reminderId} {
        allow read: if canReadClinicalData();
        allow create, update, delete: if isAdmin();

        match /readReceipts/{receiptId} {
          allow read: if canReadReminderReceipt();
          allow create, update: if canWriteReminderReceipt();
          allow delete: if isAdmin();
        }
      }

      // Transient prescription-photo backup. Uploads are server-mediated by
      // submitPrescriptionPhoto; clients can only read/edit metadata.
      match /prescriptions/{prescriptionId} {
        allow read: if canReadClinicalData();
        allow create: if false;
        allow update: if canEdit();
        allow delete: if canEdit();
      }
      
      match /exportPasswords/{passwordId} {
        allow read: if canReadClinicalData();
        allow write: if isAdmin();
      }
      
      match /auditLogs/{logId} {
        allow read: if canReadAppendOnlyOperationalLog();
        allow create: if canCreateAppendOnlyOperationalLogEntry();
        // Append-only: admin tampering prevention. Consolidation is read-time.
        allow update, delete: if false;
      }
      
      match /transferRequests/{transferId} {
        allow read: if canReadClinicalData();
        allow create, update: if canEdit();
        allow delete: if canEdit();
      }
      
      match /transferHistory/{transferId} {
        allow read: if canReadClinicalData();
        allow create: if canCreateEditableHospitalDocument();
        allow update, delete: if canAdminMaintainHospitalDocument();
      }
      
      match /bookmarks/{bookmarkId} {
        allow read: if canReadClinicalData();
        allow write: if canReadClinicalData();
      }

      match /backupFiles/{fileId} {
        allow read: if canReadClinicalData();
        allow create: if canCreateEditableHospitalDocument();
        allow update, delete: if canAdminMaintainHospitalDocument();
      }

      match /patients/{rut} {
        allow read: if canReadClinicalData();
        allow write: if canEdit();
      }

      match /woundCareConsents/{consentId} {
        allow read: if canReadClinicalData();
        allow create, update: if canEdit();
        allow delete: if isAdmin();
      }

      match /woundCarePhotos/{photoId} {
        allow read: if canReadClinicalData();
        allow create, update: if canEdit();
        allow delete: if isAdmin();
      }

      match /woundCareMobileUploadSessions/{sessionId} {
        allow read: if canReadClinicalData();
        allow create, update: if canEdit();
        allow delete: if isAdmin();
      }

      // Append-only. Writes mostly come from server-side Admin SDK (bypasses rules).
      // Client rule mirrors auditLogs: admin read-only.
      match /functionsTelemetry/{entryId} {
        allow read: if canReadAppendOnlyOperationalLog();
        allow create: if canCreateAppendOnlyOperationalLogEntry();
        allow update, delete: if false;
      }
    }
