    // 1.8 Payload schema helpers (optional types, bounded ints)
    // ---------------------------------------------

    function isOptionalString(payload, key) {
      return !(key in payload) || payload[key] == null || payload[key] is string;
    }

    function isOptionalBool(payload, key) {
      return !(key in payload) || payload[key] == null || payload[key] is bool;
    }

    function isOptionalBoundedInt(payload, key, maxValue) {
      return !(key in payload) ||
             payload[key] == null ||
             (payload[key] is int && payload[key] >= 0 && payload[key] <= maxValue);
    }

    function isOptionalEnum(payload, key, allowedValues) {
      return !(key in payload) ||
             payload[key] == null ||
             allowedValues.hasAny([payload[key]]);
    }

    function isSystemHealthCounter(payload, key) {
      return isOptionalBoundedInt(payload, key, 10000);
    }

    function isSystemHealthAgeMs(payload, key) {
      return isOptionalBoundedInt(payload, key, 864000000);
    }

    function hasOnlySystemHealthKeys(payload) {
      return payload.keys().hasOnly([
               'uid',
               'email',
               'displayName',
               'lastSeen',
               'isOnline',
               'isOutdated',
               'pendingMutations',
               'pendingSyncTasks',
               'failedSyncTasks',
               'conflictSyncTasks',
               'retryingSyncTasks',
               'syncOrphanedTasks',
               'oldestPendingAgeMs',
               'remoteSyncReason',
               'versionUpdateReason',
               'localErrorCount',
               'degradedLocalPersistence',
               'repositoryWarningCount',
               'slowestRepositoryOperationMs',
               'operationalObservedCount',
               'operationalFailureCount',
               'operationalRetryableCount',
               'operationalRecoverableCount',
               'operationalDegradedCount',
               'operationalBlockedCount',
               'operationalUnauthorizedCount',
               'operationalLastHourObservedCount',
               'operationalSyncObservedCount',
               'operationalIndexedDbObservedCount',
               'operationalClinicalDocumentObservedCount',
               'operationalCreateDayObservedCount',
               'operationalHandoffObservedCount',
               'operationalExportBackupObservedCount',
               'operationalDailyRecordRecoveredRealtimeNullCount',
               'operationalDailyRecordConfirmedRealtimeNullCount',
               'operationalSyncReadUnavailableCount',
               'operationalIndexedDbFallbackModeCount',
               'operationalAuthBootstrapTimeoutCount',
               'operationalTopObservedCategory',
               'operationalTopObservedOperation',
               'latestOperationalOperation',
               'latestOperationalRuntimeState',
               'latestOperationalIssueAt',
               'appVersion',
               'platform',
               'userAgent'
             ]);
    }

    function hasOnlySystemHealthResolutionKeys(payload) {
      return payload.keys().hasOnly([
               'resolutionKey',
               'status',
               'updatedAt',
               'resolvedAt',
               'resolvedByUid',
               'resolvedByEmail',
               'resolvedByName',
               'reopenedAt',
               'reopenedByUid',
               'reopenedByEmail',
               'reopenedByName',
               'note',
               'history'
             ]);
    }

    function isValidSystemHealthResolutionWrite() {
      let payload = request.resource.data;
      return canManageSystemHealthOperations() &&
             hasOnlySystemHealthResolutionKeys(payload) &&
             payload.resolutionKey is string &&
             payload.updatedAt is string &&
             payload.status in ['open', 'resolved'] &&
             isOptionalString(payload, 'resolvedAt') &&
             isOptionalString(payload, 'resolvedByUid') &&
             isOptionalString(payload, 'resolvedByEmail') &&
             isOptionalString(payload, 'resolvedByName') &&
             isOptionalString(payload, 'reopenedAt') &&
             isOptionalString(payload, 'reopenedByUid') &&
             isOptionalString(payload, 'reopenedByEmail') &&
             isOptionalString(payload, 'reopenedByName') &&
             isOptionalString(payload, 'note') &&
             (!('history' in payload) || payload.history is list);
    }

    function hasValidSystemHealthCriticalOperationalCounters(payload) {
      return isSystemHealthCounter(payload, 'operationalFailureCount') &&
             isSystemHealthCounter(payload, 'operationalSyncReadUnavailableCount');
    }

    //
    // 1.9 System health payload guard
    // ---------------------------------------------
    // - caller can only write own doc
    // - schema is constrained
    // - numeric counters are bounded to non-negative values

    function isValidSystemHealthWrite(userId) {
      let payload = request.resource.data;
      return isAuthenticated() &&
             request.auth.uid == userId &&
             hasOnlySystemHealthKeys(payload) &&
             payload.uid == request.auth.uid &&
             isOptionalString(payload, 'email') &&
             isOptionalString(payload, 'displayName') &&
             isOptionalString(payload, 'lastSeen') &&
             isOptionalBool(payload, 'isOnline') &&
             isOptionalBool(payload, 'isOutdated') &&
             isSystemHealthCounter(payload, 'pendingMutations') &&
             isSystemHealthCounter(payload, 'pendingSyncTasks') &&
             isSystemHealthCounter(payload, 'failedSyncTasks') &&
             isSystemHealthCounter(payload, 'conflictSyncTasks') &&
             isSystemHealthCounter(payload, 'retryingSyncTasks') &&
             isSystemHealthCounter(payload, 'syncOrphanedTasks') &&
             isSystemHealthAgeMs(payload, 'oldestPendingAgeMs') &&
             isOptionalEnum(payload, 'remoteSyncReason', [
               'ready',
               'auth_loading',
               'auth_connecting',
               'auth_unavailable',
               'manual_override',
               'offline',
               'runtime_unavailable'
             ]) &&
             isOptionalEnum(payload, 'versionUpdateReason', [
               'current',
               'new_build_available',
               'runtime_contract_mismatch',
               'schema_ahead_of_client'
             ]) &&
             isSystemHealthCounter(payload, 'localErrorCount') &&
             isOptionalBool(payload, 'degradedLocalPersistence') &&
             isSystemHealthCounter(payload, 'repositoryWarningCount') &&
             isSystemHealthAgeMs(payload, 'slowestRepositoryOperationMs') &&
             hasValidSystemHealthCriticalOperationalCounters(payload);
    }

    //
