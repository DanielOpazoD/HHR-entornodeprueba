    // 1.6 Clinical read access and shared access helpers
    // ---------------------------------------------

    // Consolidated read access for clinical data
    function canReadClinicalData() {
      return hasAnyEffectiveRole([
               'admin',
               'nurse_hospital',
               'doctor_urgency',
               'doctor_specialist',
               'editor',
               'viewer'
             ]);
    }

    function canReadAppendOnlyOperationalLog() {
      return isAdmin();
    }

    function canCreateAppendOnlyOperationalLogEntry() {
      return canCreateReadableClinicalDocument();
    }

    function canWriteMedicalIndicationRecord() {
      return isAdmin() || isDoctor() || isDoctorSpecialist();
    }

    function hasOnlyMedicalIndicationRecordKeys(payload) {
      return payload.keys().hasOnly([
               'id',
               'patientRut',
               'patientName',
               'episodeId',
               'bedId',
               'targetDate',
               'generatedAt',
               'generatedByUserId',
               'generatedByName',
               'generatedByRole',
               'generatedFromTemplateIds',
               'admissionDate',
               'daysOfStayForTargetDate',
               'treatingDoctor',
               'reposo',
               'regimen',
               'kineType',
               'kineTimes',
               'pendingNotes',
               'indications',
               'pdfPrintedAt'
             ]);
    }

    function hasRequiredMedicalIndicationRecordKeys(payload) {
      return payload.keys().hasAll([
               'id',
               'patientRut',
               'patientName',
               'episodeId',
               'bedId',
               'targetDate',
               'generatedAt',
               'generatedByUserId',
               'generatedByName',
               'generatedFromTemplateIds',
               'admissionDate',
               'daysOfStayForTargetDate',
               'treatingDoctor',
               'reposo',
               'regimen',
               'kineType',
               'kineTimes',
               'pendingNotes',
               'indications',
               'pdfPrintedAt'
             ]);
    }

    function isValidMedicalIndicationRecordCreate(recordId) {
      let payload = request.resource.data;

      return canWriteMedicalIndicationRecord() &&
             isAuthenticated() &&
             hasOnlyMedicalIndicationRecordKeys(payload) &&
             hasRequiredMedicalIndicationRecordKeys(payload) &&
             payload.id is string && payload.id == recordId &&
             payload.patientRut is string &&
             payload.patientName is string &&
             payload.episodeId is string &&
             payload.bedId is string &&
             payload.targetDate is string &&
             payload.generatedAt is string &&
             payload.generatedByUserId == request.auth.uid &&
             payload.generatedByName is string &&
             isOptionalEnum(payload, 'generatedByRole', ['admin', 'doctor_urgency', 'doctor_specialist']) &&
             (payload.get('generatedByRole', null) == null || payload.generatedByRole == getEffectiveRole()) &&
             payload.generatedFromTemplateIds is list &&
             payload.admissionDate is string &&
             payload.daysOfStayForTargetDate is string &&
             payload.treatingDoctor is string &&
             payload.reposo is string &&
             payload.regimen is string &&
             payload.kineType in ['motora', 'respiratoria', 'ambas', 'ninguna'] &&
             payload.kineTimes is string &&
             payload.pendingNotes is string &&
             payload.indications is list &&
             payload.indications.size() > 0 &&
             (payload.pdfPrintedAt == null || payload.pdfPrintedAt is string);
    }

    function canManageCensusAccess() {
      return hasAnyEffectiveRole(['admin', 'editor']);
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasResourceData() {
      return resource != null && resource.data != null;
    }

    //

    // Nursing may correct assignment/type metadata, never replace the uploaded source.
    function isCurrentPrescriptionActor(value) {
      return value is string &&
             (value == request.auth.uid || (hasEmail() && normalizeEmail(value) == getUserEmail()));
    }
    function canUpdatePrescription() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() || (hasEffectiveRole('nurse_hospital') &&
             changed.hasOnly(['bedId', 'patientName', 'patientRut', 'assignmentScope',
               'patientReassignedAt', 'patientReassignedBy', 'prescriptionType', 'typeUpdatedAt', 'typeUpdatedBy']) &&
             (!changed.hasAny(['bedId', 'patientName', 'patientRut', 'assignmentScope', 'patientReassignedAt', 'patientReassignedBy']) ||
               (isCurrentPrescriptionActor(request.resource.data.get('patientReassignedBy', null)) &&
                request.resource.data.get('patientReassignedAt', null) is string &&
                request.resource.data.get('assignmentScope', null) in ['patient', 'unassigned', 'hospitalized_stock'] &&
                isOptionalString(request.resource.data, 'bedId') &&
                isOptionalString(request.resource.data, 'patientName') &&
                isOptionalString(request.resource.data, 'patientRut'))) &&
             (!changed.hasAny(['prescriptionType', 'typeUpdatedAt', 'typeUpdatedBy']) ||
               (isCurrentPrescriptionActor(request.resource.data.get('typeUpdatedBy', null)) &&
                request.resource.data.get('typeUpdatedAt', null) is string &&
                request.resource.data.get('prescriptionType', null) in ['comun', 'psicotropicos', 'benzodiazepinas'])));
    }
