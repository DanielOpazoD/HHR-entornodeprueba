    // 1.5 Clinical document write/delete permissions
    // ---------------------------------------------

    function isSpecialistClinicalDocumentDraftWrite() {
      return isDoctorSpecialist() &&
             request.resource.data.status == 'draft' &&
             (
               resource == null ||
               resource.data == null ||
               resource.data.status == 'draft'
             );
    }

    function canWriteClinicalDocument() {
      return isAdmin() || isDoctor() || isSpecialistClinicalDocumentDraftWrite();
    }

    function clinicalDocumentAuthor(data) {
      let audit = data.get('audit', {});
      let author = audit is map ? audit.get('createdBy', {}) : {};
      return author is map ? author : {};
    }

    function clinicalDocumentAuthorIdentity(author, field, legacyValue) {
      let value = author.get(field, legacyValue);
      return value is string && !value.matches('^\\s*$') ? value : legacyValue;
    }

    function preservesClinicalDocumentAuthority() {
      let before = clinicalDocumentAuthor(resource.data);
      let after = clinicalDocumentAuthor(request.resource.data);
      return clinicalDocumentAuthorIdentity(before, 'uid', 'legacy-unknown') ==
               clinicalDocumentAuthorIdentity(after, 'uid', 'legacy-unknown') &&
             clinicalDocumentAuthorIdentity(before, 'email', 'legacy@unknown.local') ==
               clinicalDocumentAuthorIdentity(after, 'email', 'legacy@unknown.local') &&
             (resource.data.get('isActiveEpisodeDocument', true) != false ||
               request.resource.data.get('isActiveEpisodeDocument', true) == false) &&
             (resource.data.get('lockedReason', '') == '' ||
               (request.resource.data.get('isLocked', false) == true &&
                request.resource.data.get('lockedReason', '') == resource.data.lockedReason));
    }

    function canUpdateClinicalDocument() {
      return isAdmin() || (canWriteClinicalDocument() && preservesClinicalDocumentAuthority());
    }

    function canDeleteOwnActiveClinicalDocument() {
      return hasAnyEffectiveRole([
               'doctor_urgency',
               'doctor_specialist'
             ]);
    }

    function hasClinicalDocumentAuthorAudit() {
      return resource.data.keys().hasAny(['audit']) &&
             resource.data.audit is map &&
             resource.data.audit.keys().hasAny(['createdBy']) &&
             resource.data.audit.createdBy is map;
    }

    function isClinicalDocumentAuthorByUid() {
      return hasClinicalDocumentAuthorAudit() &&
             resource.data.audit.createdBy.keys().hasAny(['uid']) &&
             resource.data.audit.createdBy.uid == request.auth.uid;
    }

    function isClinicalDocumentAuthorByEmail() {
      return hasClinicalDocumentAuthorAudit() &&
             hasEmail() &&
             resource.data.audit.createdBy.keys().hasAny(['email']) &&
             resource.data.audit.createdBy.email is string &&
             normalizeEmail(resource.data.audit.createdBy.email) == getUserEmail();
    }

    function isClinicalDocumentAuthorForActiveEpisode() {
      return isAuthenticated() &&
             canDeleteOwnActiveClinicalDocument() &&
             resource != null &&
             resource.data.isActiveEpisodeDocument == true &&
             resource.data.isLocked == false &&
             (
               isClinicalDocumentAuthorByUid() ||
               isClinicalDocumentAuthorByEmail()
             );
    }

    function canDeleteClinicalDocument() {
      return isAdmin() ||
             isClinicalDocumentAuthorForActiveEpisode();
    }

    function canWriteClinicalAttachment() {
      return hasAnyEffectiveRole([
               'admin',
               'nurse_hospital',
               'doctor_urgency',
               'doctor_specialist',
               'editor'
             ]);
    }

    //
