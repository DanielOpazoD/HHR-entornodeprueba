    // 1.5 Clinical document write/delete permissions
    // ---------------------------------------------

    function isSpecialistClinicalDocumentDraftWrite() {
      return isDoctorSpecialist() &&
             request.resource.data.status == 'draft' &&
             (
               resource == null ||
               resource.data == null ||
               resource.data.status == 'draft'
             );
    }

    function canWriteClinicalDocument() {
      return isAdmin() || isDoctor() || isSpecialistClinicalDocumentDraftWrite();
    }

    function canDeleteOwnActiveClinicalDocument() {
      return hasAnyEffectiveRole([
               'doctor_urgency',
               'doctor_specialist'
             ]);
    }

    function hasClinicalDocumentAuthorAudit() {
      return resource.data.keys().hasAny(['audit']) &&
             resource.data.audit is map &&
             resource.data.audit.keys().hasAny(['createdBy']) &&
             resource.data.audit.createdBy is map;
    }

    function isClinicalDocumentAuthorByUid() {
      return hasClinicalDocumentAuthorAudit() &&
             resource.data.audit.createdBy.keys().hasAny(['uid']) &&
             resource.data.audit.createdBy.uid == request.auth.uid;
    }

    function isClinicalDocumentAuthorByEmail() {
      return hasClinicalDocumentAuthorAudit() &&
             hasEmail() &&
             resource.data.audit.createdBy.keys().hasAny(['email']) &&
             resource.data.audit.createdBy.email is string &&
             normalizeEmail(resource.data.audit.createdBy.email) == getUserEmail();
    }

    function isClinicalDocumentAuthorForActiveEpisode() {
      return isAuthenticated() &&
             canDeleteOwnActiveClinicalDocument() &&
             resource != null &&
             resource.data.isActiveEpisodeDocument == true &&
             resource.data.isLocked == false &&
             (
               isClinicalDocumentAuthorByUid() ||
               isClinicalDocumentAuthorByEmail()
             );
    }

    function canDeleteClinicalDocument() {
      return isAdmin() ||
             isClinicalDocumentAuthorForActiveEpisode();
    }

    function canWriteClinicalAttachment() {
      return hasAnyEffectiveRole([
               'admin',
               'nurse_hospital',
               'doctor_urgency',
               'doctor_specialist',
               'editor'
             ]);
    }

