rules_version = '2';

// Auth access changes must update src/tests/security/rulesHardeningStatic.test.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function normalizeEmail(email) {
      return email.lower();
    }

    function getUserEmail() {
      return normalizeEmail(request.auth.token.email);
    }

    function hasEmail() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    function normalizeRole(role) {
      return role == 'viewer_census'
        ? 'viewer'
        : role;
    }

    function getConfiguredRole() {
      return hasEmail() &&
             exists(/databases/$(database)/documents/config/roles)
        ? normalizeRole(get(/databases/$(database)/documents/config/roles).data[getUserEmail()])
        : null;
    }

    function getClaimRole() {
      return isAuthenticated() &&
             request.auth.token.keys().hasAny(['role']) &&
             request.auth.token.role != null
        ? normalizeRole(request.auth.token.role)
        : null;
    }

    function getEffectiveRole() {
      let configuredRole = getConfiguredRole();
      return configuredRole != null
        ? configuredRole
        : getClaimRole();
    }

    function hasEffectiveRole(role) {
      return isAuthenticated() && getEffectiveRole() == role;
    }

    function hasAnyEffectiveRole(roles) {
      let effectiveRole = getEffectiveRole();
      return isAuthenticated() &&
             effectiveRole != null &&
             roles.hasAny([effectiveRole]);
    }

    //
    // 1.3 Role predicates (convenience wrappers)
    // ---------------------------------------------

    function isAdmin() {
      return hasEffectiveRole('admin');
    }

    function hasAdminOrEffectiveRole(role) {
      return isAdmin() || hasEffectiveRole(role);
    }

    function isDoctor() {
      return hasAdminOrEffectiveRole('doctor_urgency');
    }

    function isDoctorSpecialist() {
      return hasAdminOrEffectiveRole('doctor_specialist');
    }

    // Check if user can edit (admin or nurse)
    function canEdit() {
      return hasAnyEffectiveRole(['admin', 'nurse_hospital']);
    }

    function canReportSystemHealth() {
      return canEdit();
    }

    function canManageSystemHealthOperations() {
      return isAdmin();
    }

    function canManageClinicalConflictSnapshots() {
      return hasAnyEffectiveRole(['admin', 'nurse_hospital']);
    }

    function isEditorRole() {
      return hasEffectiveRole('editor');
    }

    //
