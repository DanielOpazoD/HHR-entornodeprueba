rules_version = '2';

// Auth access changes must update src/tests/security/rulesHardeningStatic.test.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    function individualAccessPolicy() {
      let p = /databases/$(database)/documents/config/individualAccounts;
      return exists(p) ? get(p).data : {};
    }

    function hasManagedAccount() {
      return request.auth != null && exists(/databases/$(database)/documents/hhr_account_access/$(request.auth.uid));
    }

    function managedAccount() {
      return get(/databases/$(database)/documents/hhr_account_access/$(request.auth.uid)).data;
    }

    function hasCurrentManagedSession() {
      let account = managedAccount();
      let authTime = request.auth.token.get('auth_time', 0);
      return account.status == 'active' && account.get('credentialOperation', null) == null &&
        request.auth.token.get('hhrAccountVersion', -1) == account.version &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password' &&
        authTime > 0 && authTime <= request.time.toMillis() / 1000 + 60 &&
        request.time.toMillis() / 1000 < authTime + 43200;
    }

    function protectedGoogleRole() {
      let email = request.auth.token.get('email', '').lower();
      let known = individualAccessPolicy().get('protectedGoogle', {});
      let verified = request.auth.token.get('email_verified', false) &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com' &&
        known.get(email, '') == request.auth.uid;
      return verified ? individualAccessPolicy().get('protectedRoles', {}).get(request.auth.uid, null) : null;
    }

    function isIndividualAccessEnabled() {
      return individualAccessPolicy().get('enabled', false) == true;
    }

    function isAuthenticated() {
      return request.auth != null && (hasManagedAccount() ? hasCurrentManagedSession() :
        (!request.auth.uid.matches('hhrn_.*') && !request.auth.token.keys().hasAny(['hhrAccountVersion']) &&
          request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password' &&
          (!isIndividualAccessEnabled() || protectedGoogleRole() != null)));
    }
    
    function normalizeEmail(email) {
      return email.lower();
    }

    function getUserEmail() {
      return normalizeEmail(request.auth.token.email);
    }

    function hasEmail() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    function normalizeRole(role) {
      return role == 'viewer_census'
        ? 'viewer'
        : role;
    }

    function getLegacyEffectiveRole() {
      // Called only after the current-session guard in getEffectiveRole.
      let email = request.auth.token.get('email', null);
      let rolesPath = /databases/$(database)/documents/config/roles;
      let configuredRole = email is string && exists(rolesPath)
        ? get(rolesPath).data.get(email.lower(), null)
        : null;
      return normalizeRole(configuredRole != null
        ? configuredRole : request.auth.token.get('role', null));
    }

    function getEffectiveRole() {
      // Direct role consumers (including daily-record updates) must also fail closed.
      return !isAuthenticated() ? null : hasManagedAccount() ? managedAccount().role :
        isIndividualAccessEnabled() ? protectedGoogleRole() : getLegacyEffectiveRole();
    }

    function hasEffectiveRole(role) {
      return getEffectiveRole() == role;
    }

    function hasAnyEffectiveRole(roles) {
      let effectiveRole = getEffectiveRole();
      return effectiveRole != null &&
             roles.hasAny([effectiveRole]);
    }

    //
    // 1.3 Role predicates (convenience wrappers)
    // ---------------------------------------------

    function isAdmin() {
      return hasEffectiveRole('admin');
    }

    function hasAdminOrEffectiveRole(role) {
      return hasAnyEffectiveRole(['admin', role]);
    }

    function isDoctor() {
      return hasAdminOrEffectiveRole('doctor_urgency');
    }

    function isDoctorSpecialist() {
      return hasAdminOrEffectiveRole('doctor_specialist');
    }

    // Check if user can edit (admin or nurse)
    function canEdit() {
      return hasAnyEffectiveRole(['admin', 'nurse_hospital']);
    }

    function canReportSystemHealth() {
      return canEdit();
    }

    function canManageSystemHealthOperations() {
      return isAdmin();
    }

    function canManageClinicalConflictSnapshots() {
      return hasAnyEffectiveRole(['admin', 'nurse_hospital']);
    }

    function isEditorRole() {
      return hasEffectiveRole('editor');
    }

    //
