    // 1.10 Editing window helpers
    // ---------------------------------------------
    // Nurse window: can edit yesterday, today and tomorrow.
    // Calculation: (CurrentTime - RecordTime) should be between -24h and +48h.

    function isWithinEditingWindow(recordTS) {
      let now = request.time.toMillis();
      return recordTS is int && (
             now > (recordTS - 86400000) && 
             now < (recordTS + 172800000)
      );
    }

    //
    // 1.11 Medical signature update helpers
    // ---------------------------------------------
    // Checks whether an update is limited to medical signature fields.

    function isMedicalUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly([
        'medicalSignature',
        'medicalSignatureByScope',
        'medicalHandoffDoctor',
        'medicalHandoffSentAt',
        'medicalHandoffSentAtByScope',
        'medicalSignatureLinkTokenByScope',
        'lastUpdated'
      ]);
    }

    function dailyRecordTimestampDate(recordTS) {
      let recordTime = timestamp.value(recordTS);
      return string(recordTime.year()) + '-' +
             (recordTime.month() < 10 ? '0' : '') + string(recordTime.month()) + '-' +
             (recordTime.day() < 10 ? '0' : '') + string(recordTime.day());
    }

    function hasValidDailyRecordTimestamp() {
      let currentTS = resource.data.get('dateTimestamp', null);
      let nextTS = request.resource.data.get('dateTimestamp', null);
      return nextTS is int &&
             (currentTS == null || nextTS == currentTS) &&
             resource.data.get('date', '') == resource.id &&
             request.resource.data.get('date', '') == resource.id &&
             dailyRecordTimestampDate(nextTS) == resource.id;
    }

    function canNurseUpdatePersistedDailyRecord() {
      return hasValidDailyRecordTimestamp() &&
             isWithinEditingWindow(request.resource.data.dateTimestamp);
    }

    function canDoctorUpdatePersistedDailyRecord() {
      return isMedicalUpdate();
    }

    function canSpecialistUpdatePersistedDailyRecord() {
      return isSpecialistMedicalHandoffPayload();
    }

    function hasPersistedDailyRecordResource() {
      return resource != null && resource.data != null;
    }

    function canUpdatePersistedDailyRecord() {
      let effectiveRole = getEffectiveRole();

      return hasPersistedDailyRecordResource()
        ? (
            effectiveRole == 'admin'
              ? true
              : effectiveRole == 'nurse_hospital'
                ? canNurseUpdatePersistedDailyRecord()
                : effectiveRole == 'doctor_urgency'
                  ? canDoctorUpdatePersistedDailyRecord()
                  : effectiveRole == 'doctor_specialist'
                    ? canSpecialistUpdatePersistedDailyRecord()
                    : false
          )
        : false;
    }

    // Split days (clinicalDerived episode documents): only the server sets the marker, so a
    // client update leaves it exactly as it is, and a marked day keeps an integer meta.revision
    // that never moves back; episode documents record the day revision they were written with.
    function preservesClinicalDerivedLayout() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['clinicalDerivedLayout']) &&
             (!('clinicalDerivedLayout' in resource.data) ||
              (request.resource.data.get(['meta', 'revision'], 0) is int &&
               request.resource.data.get(['meta', 'revision'], 0) >=
                 resource.data.get(['meta', 'revision'], 0)));
    }

    // A client can never create a day that already carries the marker: only the server marks,
    // with a fresh generation, so a forged or copied marker cannot switch a day to split mode.
    function createsWithoutClinicalDerivedLayout() {
      return !('clinicalDerivedLayout' in request.resource.data);
    }

    function canAdminMaintainHospitalDocument() {
      return isAdmin();
    }

    function canCreateEditableHospitalDocument() {
      return canEdit();
    }

    function canCreateReadableClinicalDocument() {
      return canReadClinicalData();
    }
    
