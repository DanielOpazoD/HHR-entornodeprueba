    function isValidRayenImportPolicy() {
      let policy = request.resource.data;
      return policy.keys().hasOnly([
               'schemaVersion', 'mode', 'clinicalBatchMode', 'revision', 'updatedAt', 'updatedByUid'
             ]) &&
             policy.schemaVersion == 2 &&
             policy.mode in ['preview', 'auto'] &&
             policy.clinicalBatchMode in ['off', 'shadow', 'enforced'] &&
             policy.revision is int &&
             policy.revision >= 1 &&
             policy.updatedAt is timestamp &&
             policy.updatedAt == request.time &&
             policy.updatedByUid is string &&
             policy.updatedByUid == request.auth.uid;
    }

    function canCreateRayenImportPolicy() {
      return isAdmin() &&
             isValidRayenImportPolicy() &&
             request.resource.data.revision == 1;
    }

    function canUpdateRayenImportPolicy() {
      return isAdmin() &&
             isValidRayenImportPolicy() &&
             request.resource.data.revision == resource.data.revision + 1;
    }

    function isRayenClinicalWriteFenceActive(hospitalId) {
      let policyPath = /databases/$(database)/documents/hospitals/$(hospitalId)/settings/rayenImportPolicy;
      return exists(policyPath) &&
             get(policyPath).data.schemaVersion == 2;
    }

    // Admin SDK callables bypass client rules. Migrating the server-owned policy to schema v2 is
    // therefore an irreversible write-authority boundary: changing the operational batch mode
    // back to off/shadow must not re-authorize stale clients or persisted v1 outbox entries.
    function preservesServerOwnedClinicalState(hospitalId) {
      return !isRayenClinicalWriteFenceActive(hospitalId) ||
             !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'beds',
               'bedTypeOverrides'
             ]);
    }
