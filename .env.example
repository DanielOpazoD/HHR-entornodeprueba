# Environment Variables for HHR Hospital Tracker
# Copy this file to .env.local and fill in the values

# ============================================
# Firebase Configuration
# ============================================
# Use plain API key or the optional base64 variant. Production on Netlify
# can rely on runtime config instead of exposing all values in local files.
VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_API_KEY_B64=base64_encoded_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Legacy Firebase reads are disabled by default in this testing repository.
# Do not configure VITE_LEGACY_FIREBASE_* for hospital-hanga-roa here.
VITE_LEGACY_COMPATIBILITY_MODE=disabled

# Optional local emulators
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
# VITE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ============================================
# Daily Record Authority Mode
# ============================================
# Local development may stay client-only. Release must use VITE_DAILY_RECORD_AUTHORITY_MODE=enforced
# so daily-record writes go through callable revision guards.
VITE_DAILY_RECORD_AUTHORITY_MODE=client_only

# Rayen clinical enrichment batch rollout. Enforced is the operational fast path after the
# telemetry gate; use shadow for a bounded revalidation and off as the immediate rollback.
VITE_RAYEN_CLINICAL_ENRICHMENT_BATCH_MODE=enforced

# ============================================
# Security Configuration
# ============================================
# Secret key for offline passport signatures (min 32 characters recommended)
# WARNING: This key is visible in the client bundle. For maximum security,
# passport verification should be done server-side via Cloud Functions.
VITE_PASSPORT_SECRET=your-secure-random-key-min-32-chars

# ============================================
# Gmail API (for Netlify Functions only)
# ============================================
# These are NOT prefixed with VITE_ as they are server-side only
# GMAIL_CLIENT_ID=your_gmail_client_id
# GMAIL_CLIENT_SECRET=your_gmail_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token

# ============================================
# Local Development Email Flow (optional)
# ============================================
# Keep disabled by default to avoid accidental real email dispatches from localhost.
# Set to true only when intentionally testing end-to-end with local functions.
# VITE_ALLOW_DEV_EMAIL_SEND=false
# Optional override if your local function endpoint differs.
# VITE_CENSUS_EMAIL_ENDPOINT=/.netlify/functions/send-census-email

# ============================================
# Local Development AI Fallback (optional)
# ============================================
# Used only in localhost/dev for AI fallback when Netlify Functions
# are not available. Do not define production provider keys as VITE_* values.
# VITE_LOCAL_AI_PROVIDER=gemini
# VITE_LOCAL_GEMINI_API_KEY=your_local_dev_only_gemini_key
# VITE_LOCAL_OPENAI_API_KEY=your_local_dev_only_openai_key
# VITE_LOCAL_ANTHROPIC_API_KEY=your_local_dev_only_anthropic_key
# Optional override if your local clinical AI function endpoint differs.
# VITE_CLINICAL_AI_SUMMARY_ENDPOINT=/.netlify/functions/clinical-ai-summary

# ============================================
# Server-side AI Providers (Netlify Functions only)
# ============================================
# Configure ONE provider explicitly with AI_PROVIDER, or omit it and the app
# will use the first configured key in this order: Gemini -> OpenAI -> Anthropic.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_server_side_gemini_key
# GEMINI_MODEL=gemini-3-flash-preview
# OPENAI_API_KEY=your_server_side_openai_key
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_server_side_anthropic_key
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ============================================
# Google Drive Editing (optional)
# ============================================
# Required only for "Editar Cloud" in transfer documents.
# Create a Web OAuth Client in Google Cloud and authorize your localhost/Netlify origins.
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# ============================================
# Auth / Diagnostics Flags (optional)
# ============================================
# Prefer redirect-based Google sign-in on localhost, avoiding the Cross-Origin-
# Opener-Policy popup breakage (Chrome blocks the post-auth window.close()). The
# Vite dev server also sends `COOP: unsafe-none` to mirror netlify.toml, but redirect
# sidesteps the popup entirely. Recommended for local dev (set in .env.development.local).
# VITE_AUTH_PREFER_REDIRECT_ON_LOCALHOST=false
# VITE_AUTH_AUTO_REDIRECT_FALLBACK=true
# VITE_DEBUG_REPOSITORY=false
# VITE_WHATSAPP_BOT_URL=https://your-bot.example

# ============================================
# MMRAD RIS Credentials (Netlify Functions only)
# ============================================
# Required for the mmrad-search function (radiology exam lookup).
# These are NOT prefixed with VITE_ as they are server-side only.
# MMRAD_USERNAME=your_mmrad_username
# MMRAD_PASSWORD=your_mmrad_password
