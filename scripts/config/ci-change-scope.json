{
  "version": 1,
  "maxFiles": 50,
  "docsOnly": {
    "directories": ["docs/**"],
    "rootFiles": [
      "ARCHITECTURE.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "PROJECT_STATUS.md",
      "README.md"
    ],
    "excluded": ["docs/api/**"]
  },
  "functionsOnly": {
    "directories": ["functions/**"],
    "supportFiles": [
      "scripts/check-deployed-firebase-functions.mjs",
      "scripts/check-firebase-function-delete-result.mjs",
      "scripts/check-firebase-function-regions.mjs",
      "scripts/list-firebase-function-targets.mjs"
    ],
    "excluded": ["functions/package.json", "functions/package-lock.json"]
  },
  "toolingOnly": {
    "controls": [
      "scripts/check-architecture.mjs",
      "scripts/check-bundle-risk-ledger.mjs",
      "scripts/check-census-export-contract-boundary.mjs",
      "scripts/check-census-feature-boundary.mjs",
      "scripts/check-census-runtime-boundary.mjs",
      "scripts/check-clinical-clock.mjs",
      "scripts/check-clinical-documents-feature-boundary.mjs",
      "scripts/check-clinical-mutation-audit-policy.mjs",
      "scripts/check-core-console-usage.mjs",
      "scripts/check-core-test-boundary.mjs",
      "scripts/check-core-trivial-tests.mjs",
      "scripts/check-critical-any.mjs",
      "scripts/check-declared-dependencies.mjs",
      "scripts/check-empty-on-failure-reads.mjs",
      "scripts/check-firestore-emulator-governance.mjs",
      "scripts/check-folder-dependencies.mjs",
      "scripts/check-guardrail-governance.mjs",
      "scripts/check-handoff-pdf-contract-boundary.mjs",
      "scripts/check-import-cycles.mjs",
      "scripts/check-lazy-views-feature-entrypoints.mjs",
      "scripts/check-legacy-permissions-boundary.mjs",
      "scripts/check-legacy-retirement-debt.mjs",
      "scripts/check-legacy-staff-boundary.mjs",
      "scripts/check-module-size.mjs",
      "scripts/check-native-dialogs.mjs",
      "scripts/check-persistence-hub-boundaries.mjs",
      "scripts/check-repo-hygiene.mjs",
      "scripts/check-runtime-contracts.mjs",
      "scripts/check-schema-governance.mjs",
      "scripts/check-shared-layer-boundary.mjs",
      "scripts/check-source-any.mjs",
      "scripts/check-sync-invariants.mjs",
      "scripts/check-test-governance.mjs",
      "scripts/check-unreachable-modules.mjs"
    ],
    "paths": ["src/tests/scripts/**", "src/tests/build/**"]
  }
}
