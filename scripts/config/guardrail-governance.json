{
  "version": 1,
  "blockingTiers": [],
  "releaseConfidence": {
    "script": "test:release-confidence",
    "requiredScripts": [
      "test:smoke:critical-runtime",
      "test:rules:ci",
      "test:emulator:sync:ci",
      "check:critical-coverage",
      "check:flow-performance-budget",
      "test:e2e:critical:ci"
    ],
    "purpose": "Pack blocking compacto para release confidence sin duplicar toda la suite unitaria."
  },
  "reportOnly": [
    {
      "id": "quality_metrics",
      "script": "report:quality-metrics",
      "artifact": "reports/quality-metrics.md"
    },
    {
      "id": "operational_health",
      "script": "report:operational-health",
      "artifact": "reports/operational-health.md"
    },
    {
      "id": "bundle_risk_ledger",
      "script": "report:bundle-risk-ledger",
      "artifact": "reports/bundle-risk-ledger.md"
    },
    {
      "id": "system_confidence",
      "script": "report:system-confidence",
      "artifact": "reports/system-confidence.md"
    },
    {
      "id": "compatibility_governance",
      "script": "report:compatibility-governance",
      "artifact": "reports/compatibility-governance.md"
    },
    {
      "id": "legacy_retirement_debt",
      "script": "report:legacy-retirement-debt",
      "artifact": "reports/legacy-retirement-debt.md"
    },
    {
      "id": "release_readiness",
      "script": "report:release-readiness-scorecard",
      "artifact": "reports/release-readiness-scorecard.md"
    },
    {
      "id": "release_confidence_matrix",
      "script": "report:release-confidence-matrix",
      "artifact": "reports/release-confidence-matrix.md"
    },
    {
      "id": "runtime_contracts",
      "script": "report:runtime-contracts",
      "artifact": "reports/runtime-contracts.md"
    },
    {
      "id": "guardrail_governance",
      "script": "report:guardrail-governance",
      "artifact": "reports/guardrail-governance.md"
    },
    {
      "id": "technical_ownership",
      "script": "report:technical-ownership-map",
      "artifact": "reports/technical-ownership-map.md"
    },
    {
      "id": "test_runtime_governance",
      "script": "report:test-runtime-governance",
      "artifact": "reports/test-runtime-governance.md"
    },
    {
      "id": "unit_shard_runtime_profile",
      "script": "report:unit-shard-runtime-profile",
      "artifact": "reports/unit-shard-runtime-profile.md"
    },
    {
      "id": "ci_runtime_observed_profile",
      "script": "report:ci-runtime-observed-profile",
      "artifact": "reports/ci-runtime-observed-profile.md"
    }
  ],
  "qualityAggregate": {
    "script": "check:quality",
    "checks": [
      { "id": "check:architecture", "group": "boundaries" },
      { "id": "check:source-patterns", "group": "boundaries" },
      { "id": "report:compatibility-governance", "group": "governance-inputs" },
      { "id": "check:legacy-retirement-debt", "group": "governance" },
      { "id": "check:runtime-contracts", "group": "governance" },
      { "id": "check:sync-invariants", "group": "governance" },
      { "id": "check:serverless-runtime-governance", "group": "governance" },
      { "id": "check:serverless-sensitive-coverage", "group": "governance" },
      { "id": "check:docs-drift", "group": "governance" },
      { "id": "check:operational-runbooks", "group": "governance" },
      { "id": "check:feature-map", "group": "governance" },
      { "id": "check:folder-dependencies", "group": "boundaries" },
      { "id": "check:module-size", "group": "size" },
      { "id": "check:clinical-clock", "group": "boundaries" },
      { "id": "check:declared-dependencies", "group": "hygiene" },
      { "id": "check:extension-source", "group": "hygiene" },
      { "id": "check:empty-on-failure-reads", "group": "boundaries" },
      { "id": "check:import-cycles", "group": "boundaries" },
      { "id": "check:unreachable-modules", "group": "boundaries" },
      { "id": "check:firestore-emulator-governance", "group": "governance" },
      { "id": "check:ci-artifact-contracts", "group": "governance" },
      { "id": "check:test-governance", "group": "tests" },
      { "id": "check:test-runtime-governance", "group": "tests" },
      { "id": "check:guardrail-governance", "group": "governance" },
      { "id": "check:release-evidence-contract", "group": "governance" },
      {
        "id": "check:report-freshness",
        "group": "reports",
        "reportOnly": true,
        "rationale": "Surfaces stale report artifacts as advisory locally; CI already regenerates and enforces them blocking. Avoids forcing a 30s+ regeneration on every check:quality run."
      },
      { "id": "check:repo-hygiene", "group": "hygiene" },
      { "id": "check:clinical-mutation-audit-policy", "group": "security" },
      { "id": "check:security", "group": "security" },
      { "id": "check:bundle-risk-ledger", "group": "size" }
    ]
  },
  "guardrailPolicy": {
    "creationRule": "Todo guardrail nuevo nace como report-only salvo que proteja un riesgo ya materializado.",
    "promotionRule": "Un guardrail se vuelve blocking solo si existe owner, baseline y runbook de falla.",
    "retirementRule": "Un guardrail puede retirarse solo si otro gate cubre explicitamente el mismo riesgo."
  }
}
