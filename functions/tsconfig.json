{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "strictNullChecks": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["index.js", "lib/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "lib/generated/**"]
}
